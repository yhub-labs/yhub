{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/master/crates/tauri-utils/schema.json",
  "productName": "Y-Hub",
  "version": "0.1.7",
  "identifier": "com.yhub.desktop",
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../THIRD-PARTY.md": "THIRD-PARTY.md",
      "../LICENSE": "LICENSE"
    },
    "macOS": {
      "signingIdentity": "Y-Hub Local Dev"
    },
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "frontendDist": "../web/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bash packaging/build-app-assets.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Y-Hub",
        "width": 720,
        "height": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8790; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  }
}
